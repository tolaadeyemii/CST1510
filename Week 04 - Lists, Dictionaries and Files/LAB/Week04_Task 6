def isSublist(larger, smaller):
    if len(smaller) == 0:
        return True
    if len(smaller) > len(larger):
        return False
    
    for i in range(len(larger) - len(smaller) + 1):
        chunk = larger[i : 1 + len(smaller)]

        if chunk == smaller:
            return True
        return False
    main_list = [1,2,3,4]
    print(isSublist(main_list, [1,2]))
    print(isSublist(main_list, [2,4]))