def countRange(my_list, min_value, max_value):
    count = 0
    for num in my_list:
        if num >= min_value and num < max_value:
            count = count + 1
    return count

nums1 = [10, 15, 20, 25, 30, 35]
low1 = 15
high1 = 30
result1 = countRange(nums1, low1, high1)

print("Integer test list:", nums1)
print("Count between", low1, "and", high1, "is:", result1)
print()

