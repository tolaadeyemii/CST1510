def sum_row(matrix, rowIndex):
    return sum(matrix[rowIndex])

matrix = []
print("Enter a 4 by 4 matrix( 4 space seperated numbers per line): ")
for i in range(4):
    while True:
        try:
            row = list(map(float, input(f"Row {i+1}:").split()))
            if len(row) !=4:
               print("Error: Each row must contain exactly 4 numbers.")
            continue
            matrix.append(row)
            break
        except ValueError:
            print("Invalid input. Please enter numbers only.")

# Display the sum of each row
print("\nRow Sums:")
for i in range(4):
    total = sum_row(matrix, i)
    print(f"Sum of row {i+1}: {total}") 