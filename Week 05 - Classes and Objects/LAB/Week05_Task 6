class Book:
    def __init__(self, title, author, is_available=True):
        self.title = title
        self.author = author
        self.is_available = is_available

    def borrow(self):
        if self.is_available:
            self.is_available = False
            print(f"You have successfully borrowed '{self.title}'.")
        else:
            print(f"Sorry, '{self.title}' is already borrowed.")

    def return_book(self):
        if not self.is_available:
            self.is_available = True
            print(f"Thank you for returning '{self.title}'.")
        else:
            print(f"'{self.title}' was already available in the library.")

library = [
    Book("The Hobbit", "J.R.R.", "Tolkien"),
    Book("1984", "George Orwell"),
    Book("To Kill a Mockingbird", "Harper Lee"),
    Book("Animal Farm", "George Orwell")
]
print("--- Step 1: Testing Borrowing ---")
library[0].borrow()  # Successfully borrows the first book
library[0].borrow()  # Tries to borrow it again

print("\n--- Step 2: Available Books ---")
for book in library:
    if book.is_available:
        print(f"- {book.title} by {book.author}")

print("\n--- Step 3: Search by Author ---")
search_author = input("Enter an author's name to search: ")
found = False

for book in library:
    if book.author.lower() == search_author.lower():
        print(f"- {book.title} (Available: {book.is_available})")
        found = True

if not found:
    print(f"No books found by author '{search_author}'.")