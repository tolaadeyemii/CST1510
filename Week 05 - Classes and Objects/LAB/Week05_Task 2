class Dog:
    def __init__(self, name, age):
        self.name = name
        self.age = age

    def bark(self):
        print(f"{self.name} says Woof!")
    def birthday(self):
        self.age +=1
my_dog = Dog("Buddy", 3)
my_dog.bark()

my_dog.birthday()
my_dog.birthday()

print(f"{my_dog.name}'s new age is {my_dog.age}")