def is_valid_id(student_id):
    if student_id.startswith("M00") and len(student_id) == 9 and student_id[3:].isdigit():
        return True
    else:
        return False
student_ids = ["M00123456", "M0012345", "X00123456", "M00ABCDEF", "M0987654"]

for student_id in student_ids:
    print(student_id, is_valid_id(student_id))