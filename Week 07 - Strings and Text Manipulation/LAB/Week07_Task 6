logs = [
    "[14:32:05] ERROR: Disk full",
    "[14:32:10] INFO: Server started",
    "[14:32:30] WARNING: High memory usage",
    "[14:33:15] INFO: Backup complete",
    "[14:34:00] ERROR: Connection refused",
    "[14:34:22] WARNING: CPU at 90%"
]
error_count = 0
warning_count = 0

for log in logs:
    timestamp = log.split("]")[0].strip("[")

    if "ERROR" in log:
        error_count += 1
        print(timestamp)

    elif "WARNING" in log:
        warning_count += 1
        print(timestamp)

print("Total errors:", error_count)
print("Total warnings:", warning_count)