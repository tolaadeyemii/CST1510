course_stats = df.groupby('Course').agg(
    Count=('Name', 'count'),
    Avg_Grade=('Grade', lambda x: x.mean().round(1)),
    Max_Grade=('Grade', 'max'),
    Avg_Attendance=('Attendance', lambda x: x.mean().round(1))
).sort_values(by='Avg_Grade', ascending=False)

print("--- Course Statistics ---")
print(course_stats)

