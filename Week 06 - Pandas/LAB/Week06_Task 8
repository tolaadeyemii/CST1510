import pandas as pd
df = pd.read_csv('01 - Series and DataFrame/examples/servers.csv')

import pandas as pd
course_stats = df.groupby('Course').agg(
    Count=('Student_ID', 'count'), 
    Avg_Grade=('Grade', 'mean'),
    Max_Grade=('Grade', 'max'),
    Avg_Attendance=('Attendance', 'mean')
)
course_stats['Avg_Grade'] = course_stats['Avg_Grade'].round(1)
course_stats['Avg_Attendance'] = course_stats['Avg_Attendance'].round(1)
course_stats = course_stats.sort_values(by='Avg_Grade', ascending=False)

print(course_stats)