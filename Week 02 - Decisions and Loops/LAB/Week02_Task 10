human_years = float(input("Enter the number of human years: "))
if human_years < 0:
    print("Error: Age cannot be negative")
elif human_years <= 2:
    dog_years = human_years * 10.5
    print("Dog years:", dog_years)
else:
    dog_years = 21 + (human_years - 2)* 4
    print("Dog years:", dog_years)