weight_lbs = float(input("Enter weight in pounds:"))
height_inches = float(input("Enter height in inches:"))
weight_kg = weight_lbs * 0.45359237
height_m = height_inches * 0.0254
bmi = weight_kg / (height_m * height_m)
print("BMI:", bmi)

if bmi < 18.5:
    print("Intepretation: Underweight")
elif bmi < 25.0:
    print("Intepretation: Normal")
elif bmi < 30.0:
    print("Intepretation: Overweight")
else:
    print("Intepretation: Obese")