def compress_string(text):

    if len(text) <= 1:
        return text
        
    compressed_text = ""
    i = 0
    
    while i < len(text):
        count = 1

        while i + 1 < len(text) and text[i] == text[i+1]:
            count = count + 1
            i = i + 1
            
        compressed_text = compressed_text + text[i] + str(count)
        i = i + 1
        

    if len(compressed_text) < len(text):
        return compressed_text
    else:
        return text

print(compress_string("aaabbbcccdddeee"))  
print(compress_string("Hello"))           