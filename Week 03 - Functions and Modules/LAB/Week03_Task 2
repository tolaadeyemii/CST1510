def convert_length():
    print("1. Meters to Feet")
    print("2. Inches to Centimeters")
    print("3. Miles to Kilometers")
    choice = input("Pick one: ")
    
    num = float(input("Enter number: "))
    
    if choice == "1":
        ans = num * 3.28
        print("Result:", ans)
    elif choice == "2":
        ans = num * 2.54
        print("Result:", ans)
    elif choice == "3":
        ans = num * 1.6
        print("Result:", ans)

def convert_temp():
    print("1. C to F")
    print("2. F to C")
    choice = input("Pick one: ")
    
    num = float(input("Enter number: "))
    
    if choice == "1":
        ans = (num * 9/5) + 32
        print("Result:", ans)
    elif choice == "2":
        ans = (num - 32) * 5/9
        print("Result:", ans)

def convert_mass():
    print("1. kg to lbs")
    print("2. lbs to kg")
    choice = input("Pick one: ")
    
    num = float(input("Enter number: "))
    
    if choice == "1":
        ans = num * 2.2
        print("Result:", ans)
    elif choice == "2":
        ans = num / 2.2
        print("Result:", ans)

